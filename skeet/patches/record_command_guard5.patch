+                    count,result=4,0 if case=='alloc_fail'else STUB
+                    assert [word(sp+i)for i in (4,8,12,16)]==[0,4096,0x3000,4]
+                elif name=='VirtualProtect':
+                    count,result=4,int(case!='protect_fail')
+                    assert [word(sp+i)for i in (4,8,12)]==[STUB,4096,0x20]
+                    u.mem_write(word(sp+16),struct.pack('<I',4))
