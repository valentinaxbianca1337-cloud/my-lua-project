+                    name=item.name.decode() if item.name else str(item.ordinal)
+                    a=API+16*len(apis);apis[a]=name;u.mem_write(item.address,struct.pack('<I',a))
+            def word(a):return struct.unpack('<I',u.mem_read(a,4))[0]
+            def api(u,a,size,user):
+                name=apis[a];sp=u.reg_read(UC_X86_REG_ESP);ret=word(sp);calls.append(name)
