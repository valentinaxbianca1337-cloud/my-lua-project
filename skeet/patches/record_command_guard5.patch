+"""Execute emitted x86 guard against original finalizer; no game/DLL entry.
+
+The synthesized invalid inputs test the new invariant, not their frequency or
+reachability in a real match. A resolver/hit-rate improvement is not measured.
+"""
+from pathlib import Path
+import hashlib
+import itertools
+import json
+import random
+import struct
+import subprocess
+
+from unicorn import Uc, UC_ARCH_X86, UC_MODE_32, UC_HOOK_CODE, UC_HOOK_MEM_WRITE
+from unicorn.x86_const import *
+
+ROOT=Path(__file__).resolve().parents[1]
+IMAGE=(ROOT/'source/skeet/Binary/skeet.bin').read_bytes()
+BASE, MEM=0x43310000, 0x200000
+CONTEXT,CANDIDATE,COMMAND,INTERVAL,COUNTERS,SP=(MEM+x for x in (0x1000,0x2000,0x3000,0x4000,0x5000,0x9000))
