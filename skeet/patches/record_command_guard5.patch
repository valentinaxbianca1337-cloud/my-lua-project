+"""Execute the Windows x86 installer with deterministic WinAPI boundaries.
+No DLL entry, injector, core entry thread, or live game is executed.
+"""
+from pathlib import Path
+import json
+import struct
+import pefile
+from unicorn import Uc, UC_ARCH_X86, UC_MODE_32, UC_HOOK_CODE
+from unicorn.x86_const import UC_X86_REG_EAX, UC_X86_REG_EIP, UC_X86_REG_ESP
+
+ROOT=Path(__file__).resolve().parents[1]
+CORE=(ROOT/'source/skeet/Binary/skeet.bin').read_bytes()
+BASE,STUB,MEM,API,STOP=0x43310000,0x50000000,0x200000,0x70000000,0x71000000
+SITE=0x43355de9
+
+def main():
+    cases=[]
+    for dllbase in (0x10000000,0x12000000):
+        for case in ('success','unknown_site','wrong_base','wrong_size','alloc_fail','protect_fail',
+                     'code_flush_fail','patch_flush_fail','concurrent_branch_change'):
+            pe=pefile.PE(str(ROOT/'build/shot_guard_install_probe.dll'));pe.relocate_image(dllbase)
+            symbols={s.name.decode():dllbase+s.address for s in pe.DIRECTORY_ENTRY_EXPORT.symbols if s.name}
+            u=Uc(UC_ARCH_X86,UC_MODE_32)
+            u.mem_map(dllbase,(pe.OPTIONAL_HEADER.SizeOfImage+4095)&~4095);u.mem_write(dllbase,pe.get_memory_mapped_image())
+            for a,n in ((BASE,len(CORE)),(STUB,4096),(MEM,0x10000),(API,0x10000),(STOP,4096)):u.mem_map(a,n)
+            u.mem_write(BASE,CORE)
+            if case=='unknown_site':u.mem_write(SITE,b'\xcc')
+            original=bytes(u.mem_read(SITE,6));apis={};calls=[];flushes=[];freed=[]
+            for lib in pe.DIRECTORY_ENTRY_IMPORT:
