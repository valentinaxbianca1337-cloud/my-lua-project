+from pathlib import Path
+import hashlib,json,struct
+import pefile
+
+r=Path(__file__).resolve().parents[1]
+core=(r/'source/skeet/Binary/skeet.bin').read_bytes()
+regions=[(0x43355de3,0x43355e07),(0x433560cd,0x43356123),
+         (0x4332fc35,0x4332fc94),(0x4334fb71,0x4334fb9e)]
+entries=json.loads((r/'source/skeet/VM/bytecode.json').read_text())
+count=0
+for unit in entries:
+    if not unit.get('main'):continue
+    for item in [unit['main']]+unit.get('others',[]):
+        count+=1;v=int(item['vip']);size=int(item['size'])
+        assert all(not(a<v+size and v<b)for a,b in regions),('VM overwrites profile',hex(v))
+cpp=(r/'source/skeet/skeet.cpp').read_text()
+tail=cpp[cpp.index('bool skeet_t::extra()'):cpp.index('bool skeet_t::entry()')]
+assert tail.index('recompile();')<tail.index('shot_guard::install')
