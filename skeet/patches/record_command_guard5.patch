+                    result=int(not(case=='code_flush_fail'and len(flushes)==1 or case=='patch_flush_fail'and len(flushes)==2))
+                    if case=='concurrent_branch_change'and len(flushes)==1:u.mem_write(SITE,b'\xcc')
